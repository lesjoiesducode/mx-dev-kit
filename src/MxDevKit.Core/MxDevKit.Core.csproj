<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral logic shared by the plugin, the tests and the preview tool.
       The plugin compiles these sources directly so that it ships as a single DLL. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MxDevKit</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
