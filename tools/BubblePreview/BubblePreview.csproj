<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the README images with the plugin's own painter.
       Needs Logi Plugin Service installed: its PluginApi and Skia libraries are loaded at run time. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MxDevKit.Preview</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LogiPluginApi" Version="6.*" ExcludeAssets="runtime;native" />
    <Compile Include="..\..\src\MxDevKit.Core\**\*.cs" Exclude="..\..\src\MxDevKit.Core\bin\**;..\..\src\MxDevKit.Core\obj\**" LinkBase="Core" />
    <Compile Include="..\..\src\MxDevKitPlugin\BubblePainter.cs" Link="BubblePainter.cs" />
    <Compile Include="..\..\src\MxDevKitPlugin\AgentLogos.cs" Link="AgentLogos.cs" />
    <Compile Include="..\..\src\MxDevKitPlugin\Octicons.cs" Link="Octicons.cs" />
    <Using Include="MxDevKit" />
    <Using Include="Loupedeck" />
  </ItemGroup>

  <Target Name="DropStyleCop" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('StyleCop'))" />
    </ItemGroup>
  </Target>

</Project>
